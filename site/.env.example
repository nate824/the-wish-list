# Copy to .env.local. With the Supabase lines empty, the site runs in demo mode (sample wishes).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Stripe (test mode). See src/lib/payments/stripe.ts and README "Stripe".
STRIPE_SECRET_KEY=                    # sk_test_... (live keys are refused unless STRIPE_ALLOW_LIVE=true)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=                # whsec_... for /api/stripe/webhook (payment_intent.succeeded/payment_failed, setup_intent.succeeded)
STRIPE_CONNECT_WEBHOOK_SECRET=        # whsec_... for /api/stripe/connect/events (v2 account events)
STRIPE_ALLOW_LIVE=

# Email (Supabase sends magic links by default; Resend later for notifications)
RESEND_API_KEY=
EMAIL_FROM=

# Bot protection - not wired yet
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=
# Pledge housekeeping (/api/cron/pledges): any long random string; call hourly with "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
